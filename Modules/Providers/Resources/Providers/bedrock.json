          "namespace": "AWS/Bedrock",
          "dimension": "ModelId",
          "inputMetric": "InputTokenCount",
          "outputMetric": "OutputTokenCount",
          "countMetric": "Invocations",
          "serviceCode": "AmazonBedrock",
          "productFilter": "modelId",
          "profileSetting": "awsProfile",
          "regionsSetting": "regions",
          "budgetSetting": "dailyBudget",
          "emptyRegionsError": "No AWS regions configured for Bedrock monitoring",
          "normalizePattern": "^(us|eu|ap|sa|ca|me|af)\\.",
