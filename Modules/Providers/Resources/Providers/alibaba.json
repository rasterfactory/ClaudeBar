  "accounts": {
    "dataSourceField": "source",
    "form": [
      {
        "id": "source",
        "label": "Sign-in method",
        "choices": [
          "api",
          "cookie"
        ],
        "defaultValue": "api"
      },
      {
        "id": "accountRegion",
        "label": "Region",
        "choices": [
          "intl",
          "cn"
        ],
        "defaultValue": "intl"
      },
      {
        "id": "apiKey",
        "label": "API key",
        "secret": true,
        "when": {
          "source": "api"
        }
      },
      {
        "id": "cookie",
        "label": "Console cookie header",
        "secret": true,
        "when": {
          "source": "cookie"
        }
      }
    ],
    "patch": {
      "api": {
        "credential": {
          "firstOf": null,
          "setting": "apiKey",
          "as": {
            "mode": "api"
          }
        },
        "fetch": {
          "httpFlow": {
            "settings": null,
            "constants": {
              "region": "{{account.accountRegion}}"
            },
            "requests": {
              "api": {
                "urlBySetting": {
                  "setting": null,
                  "value": "{{account.accountRegion}}"
                }
              },
              "dashboard": {
                "urlBySetting": {
                  "setting": null,
                  "value": "{{account.accountRegion}}"
                }
              },
              "console": {
                "urlBySetting": {
                  "setting": null,
                  "value": "{{account.accountRegion}}"
                }
              }
            }
          }
        }
      },
      "cookie": {
        "credential": {
          "firstOf": null,
          "setting": "cookie",
          "as": {
            "mode": "cookie"
          }
        },
        "fetch": {
          "httpFlow": {
            "settings": null,
            "constants": {
              "region": "{{account.accountRegion}}"
            },
            "requests": {
              "api": {
                "urlBySetting": {
                  "setting": null,
                  "value": "{{account.accountRegion}}"
                }
              },
