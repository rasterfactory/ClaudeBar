  "accounts": {
    "form": [
      {
        "id": "profile",
        "label": "AWS profile",
        "pattern": "^[A-Za-z0-9_.@+-]+$"
      },
      {
        "id": "regions",
        "label": "AWS regions (comma separated)",
        "defaultValue": "us-east-1",
        "pattern": "^[a-z]{2}(?:-[a-z]+)+-[0-9]+(?:\\s*,\\s*[a-z]{2}(?:-[a-z]+)+-[0-9]+)*$"
      },
      {
        "id": "budget",
        "label": "Daily budget in USD (0 for none)",
        "defaultValue": "0",
        "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
      }
    ],
    "patch": {
      "cloudwatch": {
        "fetch": {
          "cloudWatch": {
            "profileSetting": null,
            "regionsSetting": null,
            "budgetSetting": null,
            "profile": "{{account.profile}}",
            "regionsText": "{{account.regions}}",
            "budget": "{{account.budget}}"
          }
        }
      }
    }
