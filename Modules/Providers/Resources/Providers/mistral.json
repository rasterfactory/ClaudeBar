{
  "profile": {
    "id": "mistral",
    "name": "Mistral",
    "links": {
      "dashboard": "https://console.mistral.ai"
    },
    "look": {
      "symbol": "cat.fill",
      "icon": "MistralIcon",
      "color": {
        "light": [
          0.9,
          0.45,
          0
        ],
        "dark": [
          1,
          0.55,
          0
        ]
      },
      "gradientEnd": {
        "light": [
          0.75,
          0.25,
          0.05
        ],
        "dark": [
          0.85,
          0.35,
          0.1
        ]
      }
    }
  },
  "cli": "",
  "enabledByDefault": false,
  "defaultDataSource": "logs",
  "dataSources": [
    {
      "kind": "logs",
      "label": "Session logs",
      "summary": "Reads Vibe\u2019s recorded daily costs and token totals without network access.",
      "fetch": {
        "directory": {
          "path": "~/.vibe/logs/session",
          "pattern": "^session_",
          "file": "meta.json"
        }
      },
      "mapping": {
        "script": {
          "file": "mistral-logs.js"
        }
      }
    }
  ],
  "accounts": {
    "form": [
      {
        "id": "home",
        "label": "Vibe session-log folder",
        "absolutePath": true,
        "existingDirectory": true,
        "excludedPaths": [
          "~/.vibe/logs/session"
        ]
      }
    ],
    "patch": {
      "logs": {
        "fetch": {
          "directory": {
            "path": "{{account.home}}"
          }
        }
      }
    }
  }
}
